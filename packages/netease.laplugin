) {\n      return { success: false, error: result.error };\n    }\n    const data = result.data;\n    const code = Number(data?.code ?? 0);\n    if (code === 803) {\n      const cookie = data?.cookie || cookieStringFrom(result.setCookies);\n      logger.info(\"[NetEase] QR login success\");\n      return { success: true, code, message: data?.message ?? \"\\u767B\\u5F55\\u6210\\u529F\", cookie };\n    }\n    return { success: true, code, message: data?.message };\n  });\n}\n\n// src/netease/renewal.ts\nvar RENEW_INTERVAL_MS = 24 * 60 * 60 * 1e3;\nvar MIN_ATTEMPT_INTERVAL_MS = 10 * 60 * 1e3;\nvar CHECKED_AT = \"renewal-checked-at\";\nfunction mergeSetCookies(cookie, setCookies = []) {\n  const jar = /* @__PURE__ */ new Map();\n  const put = (pair) => {\n    const index = pair?.indexOf(\"=\") ?? -1;\n    if (!pair || index <= 0) return;\n    const [name, value] = [pair.slice(0, index).trim(), pair.slice(index + 1).trim()];\n    if (value) jar.set(name, value);\n    else jar.delete(name);\n  };\n  for (const pair of cookie.split(/;\\s*/)) put(pair);\n  for (const header of setCookies) put(header.split(\";\")[0]);\n  return [...jar].map(([name, value]) => `${name}=${value}`).join(\"; \");\n}\nfunction createCookieRenewal(host2, request, now = Date.now) {\n  let inFlight = null;\n  let lastAttempt = Number.NEGATIVE_INFINITY;\n  const exchange = async () => {\n    const cookie = host2.readSecret(\"cookie\");\n    if (!cookie) return false;\n    const result = await request(cookie);\n    if (!result.success) return false;\n    if (host2.readSecret(\"cookie\") !== cookie) return false;\n    const confirmed = result.data?.code === 200;\n    const renewed = confirmed ? mergeSetCookies(cookie, result.setCookies) : cookie;\n    host2.writeSecrets({ [CHECKED_AT]: String(now()), ...renewed !== cookie ? { cookie: renewed } : {} });\n    if (!confirmed) host2.logger.warn(\"[NetEase] Login renewal was rejected; a new QR login may be needed\");\n    return confirmed;\n  };\n  const renew = () => {\n    if (inFlight) return inFlight;\n    if (now() - lastAttempt < MIN_ATTEMPT_INTERVAL_MS) return Promise.resolve(false);\n    lastAttempt = now();\n    inFlight = exchange().catch((error) => {\n      host2.logger.warn(\"[NetEase] Login renewal failed\", error);\n      return false;\n    }).finally(() => {\n      inFlight = null;\n    });\n    return inFlight;\n  };\n  return {\n    renew,\n    renewIfDue: () => {\n      if (!host2.readSecret(\"cookie\")) return;\n      const checkedAt = Number(host2.readSecret(CHECKED_AT)) || 0;\n      if (now() - checkedAt >= RENEW_INTERVAL_MS) void renew();\n    }\n  };\n}\n\n// src/netease/index.ts\nfunction createPlugin(host2) {\n  configureHost(host2);\n  registerNetEaseHandlers();\n  const renewal = createCookieRenewal(host2, refreshNetEaseLogin);\n  const bridge = {\n    // Using the source is what keeps its login alive: once the request settles, extend\n    // the stored session if that has not happened for a day.\n    neteaseRequest: (channel, params, cookie) => invoke(\"netease-request\", [channel, params, cookie]).finally(() => {\n      renewal.renewIfDue();\n    })\n  };\n  return {\n    provider: new NetEaseMusicAPI(createContext(host2, bridge, renewal.renew)),\n    invoke,\n    validateCookie: async (cookie) => {\n      const result = await bridge.neteaseRequest(\"/nuser/account/get\", { csrf_token: \"\" }, cookie);\n      const data = result.data;\n      return result.success && data?.code === 200 && Boolean(data.account || data.profile) ? { valid: true } : { valid: false, message: result.error || \"Cookie \\u65E0\\u6548\\u6216\\u5DF2\\u8FC7\\u671F\" };\n    },\n    streamHeaders: (cookie) => ({ \"User-Agent\": \"Mozilla/5.0\", Referer: \"https://music.163.com/\", Origin: \"https://music.163.com\", ...cookie ? { Cookie: cookie } : {} })\n  };\n}\n// Annotate the CommonJS export names for ESM import in node:\n0 && (module.exports = {\n  createPlugin\n});\n","sha256":"49f8c637b3e219e41d8b0f57fa8c85b209aa